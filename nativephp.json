{
    "name": "victorycodedev/nativephp-fetch",
    "version": "1.0.0",
    "description": "Truly asynchronous native HTTP networking for NativePHP Mobile on iOS and Android.",
    "namespace": "Fetch",
    "keywords": [
        "http",
        "networking",
        "async",
        "nativephp",
        "ios",
        "android"
    ],
    "category": "utilities",
    "license": "MIT",
    "pricing": {
        "type": "free"
    },
    "author": {
        "name": "Victory Efekpogua",
        "url": "https://github.com/victorycodedev"
    },
    "platforms": [
        "android",
        "ios"
    ],
    "icon": "resources/icon.png",
    "bridge_functions": [
        {
            "name": "Fetch.Start",
            "android": "com.victorycodedev.plugins.nativephp_fetch.FetchFunctions.Start",
            "ios": "FetchFunctions.Start",
            "description": "Start an asynchronous native HTTP request"
        },
        {
            "name": "Fetch.Cancel",
            "android": "com.victorycodedev.plugins.nativephp_fetch.FetchFunctions.Cancel",
            "ios": "FetchFunctions.Cancel",
            "description": "Cancel an active asynchronous HTTP request"
        },
        {
            "name": "Fetch.Download",
            "android": "com.victorycodedev.plugins.nativephp_fetch.FetchFunctions.Download",
            "ios": "FetchFunctions.Download",
            "description": "Stream an HTTP response to an application-writable file"
        }
    ],
    "android": {
        "min_version": 29,
        "permissions": [
            "android.permission.INTERNET"
        ],
        "repositories": [],
        "dependencies": {
            "implementation": [
                "com.squareup.okhttp3:okhttp:4.12.0"
            ]
        },
        "activities": [],
        "services": [],
        "receivers": [],
        "providers": []
    },
    "ios": {
        "min_version": "18.0",
        "permissions": [],
        "repositories": [],
        "dependencies": {
            "swift_packages": [],
            "pods": []
        }
    },
    "assets": {
        "android": [],
        "ios": []
    },
    "secrets": [],
    "events": [
        "Victorycodedev\\NativephpFetch\\Events\\FetchRequestStarted",
        "Victorycodedev\\NativephpFetch\\Events\\FetchRequestCompleted",
        "Victorycodedev\\NativephpFetch\\Events\\FetchRequestFailed",
        "Victorycodedev\\NativephpFetch\\Events\\FetchRequestCancelled",
        "Victorycodedev\\NativephpFetch\\Events\\FetchUploadProgress",
        "Victorycodedev\\NativephpFetch\\Events\\FetchRequestRetrying",
        "Victorycodedev\\NativephpFetch\\Events\\FetchDownloadProgress",
        "Victorycodedev\\NativephpFetch\\Events\\FetchDownloadCompleted"
    ],
    "service_provider": "Victorycodedev\\NativephpFetch\\FetchServiceProvider",
    "hooks": {
        "copy_assets": "nativephp:fetch:copy-assets"
    }
}
