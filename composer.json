{
    "name": "victorycodedev/nativephp-fetch",
    "description": "Truly asynchronous native HTTP networking for NativePHP Mobile on iOS and Android.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "you@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Victorycodedev\\NativephpFetch\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Victorycodedev\\NativephpFetch\\FetchServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}