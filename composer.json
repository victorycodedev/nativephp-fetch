{
    "name": "victorycodedev/nativephp-fetch",
    "description": "Truly asynchronous native HTTP networking for NativePHP Mobile on iOS and Android.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "homepage": "https://github.com/victorycodedev/nativephp-fetch",
    "keywords": [
        "nativephp",
        "android",
        "ios",
        "http",
        "networking",
        "uploads",
        "downloads"
    ],
    "support": {
        "issues": "https://github.com/victorycodedev/nativephp-fetch/issues",
        "source": "https://github.com/victorycodedev/nativephp-fetch"
    },
    "authors": [
        {
            "name": "Victory Efekpogua"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "nativephp/mobile": "^4.1",
        "ramsey/uuid": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "Victorycodedev\\NativephpFetch\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Victorycodedev\\NativephpFetch\\FetchServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "pestphp/pest": "^5.1",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --debug",
        "format": "pint",
        "format:check": "pint --test",
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}